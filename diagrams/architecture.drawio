  <diagram id="photo-uploader-architecture" name="Photo Uploader Architecture">
    <mxGraphModel dx="1900" dy="1370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1370" math="0" shadow="0">
      <root>
