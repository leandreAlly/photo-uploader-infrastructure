        <mxCell id="ep2" value="VPC endpoints&lt;br&gt;ECR, Logs, Secrets&lt;br&gt;S3 gateway" style="shape=mxgraph.aws4.endpoints;fillColor=#5A30B5;gradientColor=#945DF2;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;html=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="p1"><mxGeometry x="1270" y="860" width="68" height="68" as="geometry" /></mxCell>
        <mxCell id="rds" value="RDS PostgreSQL&lt;br&gt;Multi-AZ db.t3.micro&lt;br&gt;subnet group spans both AZs" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#3334B9;gradientColor=#4D72F3;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;html=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="p1"><mxGeometry x="906" y="950" width="68" height="68" as="geometry" /></mxCell>

        <mxCell id="cloudfront" value="CloudFront&lt;br&gt;Price Class 200" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fillColor=#5A30B5;gradientColor=#945DF2;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;html=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="p1"><mxGeometry x="1620" y="520" width="78" height="78" as="geometry" /></mxCell>
