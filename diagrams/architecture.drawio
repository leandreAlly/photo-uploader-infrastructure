        <mxCell id="region" value="Region: us-east-1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#147EBA;fillColor=none;verticalAlign=top;align=left;spacingLeft=32;fontColor=#147EBA;fontSize=14;dashed=1;html=1;" vertex="1" parent="p1"><mxGeometry x="330" y="175" width="1510" height="1110" as="geometry" /></mxCell>
