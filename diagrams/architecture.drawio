        <mxCell id="title" value="Photo Uploader - architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="p1"><mxGeometry x="35" y="20" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Single region us-east-1&amp;nbsp; |&amp;nbsp; two Availability Zones&amp;nbsp; |&amp;nbsp; ECS Fargate and RDS in private subnets with no NAT gateway&lt;br&gt;GitHub Actions authenticates with OIDC&amp;nbsp; |&amp;nbsp; CloudFormation GitSync provisions every resource&amp;nbsp; |&amp;nbsp; CodeDeploy performs blue/green releases" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#5A6C7D;" vertex="1" parent="p1"><mxGeometry x="35" y="56" width="1150" height="42" as="geometry" /></mxCell>

