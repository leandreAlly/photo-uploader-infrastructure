        <mxCell id="s3_templates" value="S3 template bucket&lt;br&gt;packaged nested stacks" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#277116;gradientColor=#60A337;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;html=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="p1"><mxGeometry x="600" y="1150" width="76" height="76" as="geometry" /></mxCell>
        <mxCell id="iac_note" value="Infrastructure as code&lt;br&gt;GitSync watches deployment/main.yaml on main and deploys the root stack, which nests&lt;br&gt;network, registry, storage, data, platform and delivery. Every resource on this diagram is provisioned this way." style="rounded=1;fillColor=#F9F2FE;strokeColor=#7D3AC1;fontColor=#232F3E;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;html=1;" vertex="1" parent="p1"><mxGeometry x="760" y="1150" width="620" height="76" as="geometry" /></mxCell>

        <mxCell id="net_note" value="Network paths&lt;br&gt;Public subnets route to the internet gateway&lt;br&gt;Private route tables reach S3 through the gateway endpoint&lt;br&gt;Interface endpoints in both AZs, so no NAT gateway is needed&lt;br&gt;ALB SG to Task SG on :8080&lt;br&gt;Task SG to DB SG on :5432" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1"><mxGeometry x="35" y="700" width="235" height="150" as="geometry" /></mxCell>
        <mxCell id="scale_note" value="ECS service scaling&lt;br&gt;desired 1&amp;nbsp; |&amp;nbsp; min 1&amp;nbsp; |&amp;nbsp; max 4&lt;br&gt;target tracking on CPU 60%&lt;br&gt;ALB health check /health" style="rounded=1;fillColor=#FFF7E6;strokeColor=#D45B07;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;" vertex="1" parent="p1"><mxGeometry x="35" y="870" width="235" height="100" as="geometry" /></mxCell>
        <mxCell id="legend" value="Legend&lt;br&gt;Blue - user request path&lt;br&gt;Orange - image build and publish&lt;br&gt;Indigo - delivery pipeline&lt;br&gt;Violet - infrastructure as code&lt;br&gt;Green - private object storage&lt;br&gt;Magenta - logs and alarms&lt;br&gt;Dashed - green path or IaC action" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6C737A;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;" vertex="1" parent="p1"><mxGeometry x="35" y="990" width="235" height="150" as="geometry" /></mxCell>

