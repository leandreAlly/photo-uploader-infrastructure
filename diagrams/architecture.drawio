        <mxCell id="task2" value="ECS Fargate task" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#D05C17;gradientColor=#F78E04;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;html=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="p1"><mxGeometry x="1070" y="860" width="68" height="68" as="geometry" /></mxCell>
