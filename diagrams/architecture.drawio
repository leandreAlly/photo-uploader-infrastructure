        <mxCell id="repo_app" value="photo-uploader-app&lt;br&gt;GitHub Actions&lt;br&gt;test, build, push image" style="rounded=1;fillColor=#FFF7E6;strokeColor=#D45B07;fontColor=#232F3E;fontSize=12;align=center;html=1;" vertex="1" parent="p1"><mxGeometry x="55" y="300" width="195" height="76" as="geometry" /></mxCell>
