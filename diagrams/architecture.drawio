        <mxCell id="alb_note" value="One internet-facing Application Load Balancer, with a node in each Availability Zone&lt;br&gt;:80 production listener&amp;nbsp; |&amp;nbsp; :9000 test listener locked to 127.0.0.1/32&amp;nbsp; |&amp;nbsp; blue + green target groups" style="rounded=1;fillColor=#F3EAFB;strokeColor=#5A30B5;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;html=1;" vertex="1" parent="p1"><mxGeometry x="620" y="560" width="660" height="64" as="geometry" /></mxCell>

